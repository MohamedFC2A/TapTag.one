# ==============================================================================
# TapTag.one - Environment Variables Template
# ==============================================================================

# Neon PostgreSQL Database Connection (Serverless pooling with SSL)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-1.aws.neon.tech/taptag?sslmode=require"

# Next.js Application Public URL
NEXT_PUBLIC_APP_URL="https://taptag.one"

# Cryptographic Salt for Anti-Tamper IP Hashing & Privacy Barrier
TAPTAG_SECRET_SALT="replace_with_a_secure_random_salt_for_production"

# HMAC Secret for Dynamic Anti-Spam QR Redirect Sessions
SESSION_SECRET="replace_with_a_secure_hmac_secret_key_2026"

# Notification Dispatch Mocking (Set to false when connecting live Twilio/WhatsApp APIs)
DISPATCH_MOCK_MODE="true"
